# URL WebSocket du projet LiveKit (pas de clé publique nécessaire)
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=
# Origine exacte du site, sans slash final. Obligatoire en production.
APP_ORIGIN=http://localhost:3000

# Étape 3 : activer uniquement après application de la migration SQL
MATES_IDENTITY_MODE=prototype
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Étape 4 : après application de la deuxième migration uniquement
MATES_ROOM_CONTROLS=disabled
# Clé privilégiée sb_secret_... (ou service_role) : serveur uniquement, jamais NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
